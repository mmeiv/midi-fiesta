{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "midi-fiesta",
  "version": "0.1.0",
  "identifier": "com.midifiesta.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "midi-fiesta",
        "width": 620,
        "height": 590,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "language": {
          "en-US": {
            "localePath": "./windows/wix.en-US.wxl"
          }
        }
      }
    },
    "resources": {
      "../.midi-fiesta-build/midi-host/publish/app/MidiHost.exe": "midi-host.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
